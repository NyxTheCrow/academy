; Engine configuration file.
; Magical Academy — Spine Prototype
;
; Autoload order matters: GameData (content) first, then GameState (the spine),
; then Director (the mode/state machine) which drives the three screens.

config_version=5

[application]

config/name="Magical Academy (Spine Prototype)"
run/main_scene="res://scenes/Root.tscn"
config/features=PackedStringArray("4.2")

[autoload]

GameData="*res://scripts/GameData.gd"
GameState="*res://scripts/GameState.gd"
Students="*res://scripts/Students.gd"
Lexicon="*res://scripts/Lexicon.gd"
Game="*res://core/Game.gd"
Director="*res://scripts/Director.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
