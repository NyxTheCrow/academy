; Engine configuration file.
; Magical Academy — Spine Prototype
;
; The autoload order matters: GameData loads content first, then GameState
; (the clock/state singleton) can rely on it being present.

config_version=5

[application]

config/name="Magical Academy (Spine Prototype)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2")

[autoload]

GameData="*res://scripts/GameData.gd"
GameState="*res://scripts/GameState.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
