		"actions": [
			{ "id": "attend_lecture", "name": "Attend the lecture", "duration": 60, "effects": { "energy": -10, "stats": { "focus": -12 }, "flags": { "attended_lecture": true } }, "requires": { "tags": ["enrolled", "dressed"], "min_stats": { "focus": 8 }, "time_after": "09:00", "time_before": "12:00", "days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"] } },
			{ "id": "study_class", "name": "Study quietly", "duration": 30, "effects": { "energy": -10, "stats": { "focus": -8 } }, "requires": { "min_stats": { "focus": 8 } } }
		]
