		"connections": ["corridor_a"],
		"actions": [
			{ "id": "change_clothes", "name": "Change into uniform", "duration": 5, "effects": { "tags": ["dressed"], "remove_tags": ["scruffy"] }, "requires": { "without_tags": ["dressed"] } },
			{ "id": "wash_up", "name": "Wash up", "duration": 10, "effects": { "energy": 5, "tags": ["fresh"], "needs": { "hygiene": 30 } } },
			{ "id": "study_room", "name": "Study at your desk", "duration": 30, "effects": { "energy": -10, "stats": { "focus": -8 } }, "requires": { "min_stats": { "focus": 8 } } },
			{ "id": "sleep", "name": "Sleep until morning", "duration": 0, "sleep": true }
		]
	},
	"corridor_a": {
		"name": "Corridor A",
		"description": "A drafty stone corridor linking the dorms to the classrooms.",
		"connections": ["room", "classroom"],
		"actions": [
			{ "id": "stretch", "name": "Stretch your legs", "duration": 5, "effects": { "energy": 3 } },
			{ "id": "chat_elara", "name": "Talk with Elara", "duration": 20, "dialogue": "elara_evening", "requires": { "time_after": "17:00" } }
		]
	},
