		"name": "Amphitheatre (Building B)",
		"description": "A steep bowl of seats around a speaker's dais. First-years file in for the welcoming ceremony.",
		"connections": [],
		"actions": [
			{ "id": "welcome_ceremony", "name": "Attend the welcoming ceremony", "duration": 60, "dialogue": "ceremony_welcome", "effects": { "tags": ["oriented"] }, "requires": { "without_tags": ["oriented"] } },
			{ "id": "leave_amph", "name": "Leave the amphitheatre", "duration": 5, "goto": "courtyard" }
		]
	},
	"room": {
