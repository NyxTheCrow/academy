		"connections": [],
		"actions": [
			{ "id": "wait_in_line", "name": "Wait in line to be identified", "duration": 30, "effects": { "tags": ["id_checked"] }, "requires": { "without_tags": ["id_checked"] } },
			{ "id": "enter_courtyard", "name": "Enter the courtyard", "duration": 5, "goto": "courtyard", "requires": { "tags": ["id_checked"] } }
		]
	},
	"courtyard": {
		"name": "Courtyard",
		"description": "A broad flagstoned courtyard between the two great halls. Building A holds the dormitories; Building B, the amphitheatre.",
		"connections": [],
		"actions": [
			{ "id": "to_gates", "name": "Return to the gates", "duration": 5, "goto": "school_gates" },
			{ "id": "enter_building_a", "name": "Enter Building A (dormitories)", "duration": 5, "goto": "corridor_b" },
