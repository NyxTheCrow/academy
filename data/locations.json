	"dueling_room": {
		"name": "Dueling Room",
		"description": "A sand-floored ring warded for magical combat.",
		"connections": ["corridor_b"],
		"actions": [
			{ "id": "spar", "name": "Spar with a training dummy", "duration": 30, "effects": { "energy": -15 }, "combat": "training_dummy" },
